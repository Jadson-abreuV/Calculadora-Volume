Package: regressaoFacil
Title: Ajuste e Avaliacao de Modelos de Regressao Linear e Nao Linear
Version: 0.1.0
Authors@R: c(
    person(given = "Anderson Ribeiro",
           family = "Torres",
           role = c("aut", "cre"),
           email = "andersontorres65259@gmail.com"),
    person(given = "Jadson Coelho de",
           family = "Abreu",
           role = "aut",
